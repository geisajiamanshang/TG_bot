[Unit]
Description=Update SSC Telegram bot from GitHub main
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/ssc-bot
ExecStart=/usr/local/sbin/ssc-bot-autodeploy
TimeoutStartSec=15min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
