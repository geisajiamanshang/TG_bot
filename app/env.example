TELEGRAM_BOT_TOKEN=123456789:replace_me
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# 用逗号分隔 Telegram 数字 user_id，可通过机器人 /whoami 查看。
ADMIN_USER_IDS=123456789

DATABASE_PATH=/data/ssc_bot.db
COMPANY_NAME=Your Company
SUPPORT_CONTACT=@ffuuyao
BOT_LANGUAGE=zh-CN

# 免费广播建议不超过 30 条/秒，这里使用更保守的数值。
BROADCAST_MESSAGES_PER_SECOND=20

GOOGLE_SPREADSHEET_ID=1NuEckgwIEjzegpktBx4O6UxjFXl32LruM1j9JsYVOGw
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
WALLET_SPREADSHEET_ID=1SrvH7LuKqlekXzUUxbMAY3VNT54ApXNqG6bki9bnhXQ
WALLET_WORKFLOW_ENABLED=false
# 钱包地址助手必须是已与本机器人建立会话的 Telegram 数字 chat_id。
# WALLET_ASSISTANT_CHAT_ID=123456789

# /onboarding_notify 用：恒睿公司-联合管理工作群（新人入职通知）、人事数据同步-SSC3组（入职信息同步）。
# ONBOARDING_NOTIFY_GROUP_CHAT_ID=-1003865890708
# ONBOARDING_SYNC_GROUP_CHAT_ID=-1003801083059

# /probation_notify 用：恒睿公司-联合管理群（新人预转正提醒，和上面的 ONBOARDING_NOTIFY_GROUP_CHAT_ID
# 是同一个群）、人事数据同步-SSC3组（转正信息同步，注意这是另一个和上面 ONBOARDING_SYNC_GROUP_CHAT_ID
# 不同的群）。转正海报文件夹 ID 已经有默认值，一般不用改。
# PROBATION_UNION_GROUP_CHAT_ID=-1003865890708
# PROBATION_SYNC_GROUP_CHAT_ID=-1004468512291
# PROBATION_POSTER_DRIVE_FOLDER_ID=1ow3D3vRgUSQ6PctbcoAmbdNkjzh3kF83
# PROBATION_FORM_DRIVE_FOLDER_ID=17mscwGo9mdwQg59AJRkIwSxM-M_Sgchz

# /onboarding_notify 新增：入职协议上传用的 Drive 根文件夹 ID（北斗-恒睿/人事/入职协议），
# 下面按"<年>年-<月>月"分月存放，没有就自动新建。服务账号必须被额外共享这个文件夹的
# 【编辑者】权限（不是查看者），因为这是写入操作。
# ONBOARDING_AGREEMENT_DRIVE_FOLDER_ID=1tmNkfhM35ZbYYXu1UncC7dZCsbx_BUJq

# /training_notify 用：人事数据同步-SSC3组（次日培训信息同步）。直接复用上面
# PROBATION_SYNC_GROUP_CHAT_ID 这同一个值，不用单独配置。
